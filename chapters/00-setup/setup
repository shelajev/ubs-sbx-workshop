#!/usr/bin/env bash
# Install supplied tools and initialize a dedicated workshop backlog, once.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
export FACTORY_CONTROL_DIR="$root/.local/chapters"
command -v sbx >/dev/null
command -v jq >/dev/null
command -v sha256sum >/dev/null
"$root/scripts/install-beans.sh"
"$root/scripts/install-mcp.sh" --from-local
"$root/scripts/backlog-init.sh" --disposable
printf '\nReady: workshop tools installed and practice backlog initialized.\n'
