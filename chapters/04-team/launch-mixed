#!/usr/bin/env bash
# Presenter: same mounted app and team helpers, with the custom multi-provider base.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
chapter="${2:-04-team}"
case "$chapter" in 04-team|05-mcp|06-human|07-factory) ;; *) echo 'Choose 04-team, 05-mcp, 06-human or 07-factory'; exit 2;; esac
export WORKSHOP_BASE_KIT="$root/chapters/kits/multi-provider"
export WORKSHOP_TEAM="$root/chapters/04-team/team-mixed.tsv"
exec "$root/chapters/support/launch" "$root/chapters/$chapter" "${1:-sbx-mixed}" "${3:-$root/sample-app}"
