#!/usr/bin/env bash
# Configuration regression checks and real installed-CLI validation; no model calls.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
command -v sbx >/dev/null || { echo 'NOT RUN: sbx is required'; exit 2; }
bash "$root/scripts/tests/team-defaults.sh"
for script in "$root/chapters/support/launch" "$root/chapters/support/bin/"* "$root/chapters/00-setup/setup" "$root/chapters/0"*/launch; do
  case "$(head -1 "$script")" in *python*) python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$script";; *) bash -n "$script";; esac
done
sbx kit validate "$root/chapters/examples/hello-kit" --json
sbx env plan "$root/chapters/examples/minimal-env/sbxenv.yaml" >/dev/null
for kit in pi herdr multi-provider; do sbx kit validate "$root/chapters/kits/$kit" --json; done
for chapter in "$root/chapters/0"*/chapter.env; do
  source "$chapter"
  sbx env plan "${chapter%/*}/sbxenv.yaml" --env-arg name=sbx-chapter-plan >/dev/null
  printf 'VALID environment: %s\n' "${chapter%/*}"
done
echo 'PASS: syntax, kit validation, and real SBX environment plans. This is not an end-to-end run.'
